enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://src.fedoraproject.org/rpms/fedora-repos/raw/f43/f/RPM-GPG-KEY-fedora-43-primary

[fedora-updates]
name=Fedora 43 Everything (updates)
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/43/Everything/$basearch/
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://src.fedoraproject.org/rpms/fedora-repos/raw/f43/f/RPM-GPG-KEY-fedora-43-primary
