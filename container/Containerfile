# Source: Hummingbird core-runtime 2.43 builder, linux/amd64 release input.
FROM registry.access.redhat.com/hi/core-runtime@sha256:d939459917ebea5ea4f31187050959ad5cc833c6554b54080ebafd0c4142212c AS font-extractor

USER 0

COPY container/licenses/Iosevka-OFL-1.1.txt /tmp/Iosevka-OFL-1.1.txt
COPY container/install-font.sh /usr/local/libexec/theme-harness/install-font.sh

RUN chmod 0755 /usr/local/libexec/theme-harness/install-font.sh && \
    dnf -y install \
      tar-2:1.35-10.hum1.x86_64 \
      xz-1:5.8.3-2.hum1.x86_64 && \
    dnf clean all && \
    /usr/local/libexec/theme-harness/install-font.sh

FROM registry.access.redhat.com/hi/core-runtime@sha256:d939459917ebea5ea4f31187050959ad5cc833c6554b54080ebafd0c4142212c

ENV COLORTERM=truecolor \
    HOME=/home/nonroot \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    TZ=UTC \
    XDG_CONFIG_HOME=/home/nonroot/.config \
    XDG_DATA_HOME=/home/nonroot/.local/share

LABEL org.opencontainers.image.source="https://github.com/dark-academia-theme/testing" \
      org.opencontainers.image.title="Dark Academia theme harness" \
      org.opencontainers.image.description="Pinned terminal theme test runtime" \
      org.opencontainers.image.licenses="MIT"

USER 0

COPY container/repositories/fedora-43.repo /etc/yum.repos.d/fedora-43.repo
COPY container/fedora-43-amd64.lock /usr/share/theme-harness/locks/fedora-43-amd64.lock
COPY container/install-fedora-closure.sh /usr/local/libexec/theme-harness/install-fedora-closure.sh
COPY container/verify-fedora-closure.sh /usr/local/bin/verify-theme-harness-fedora-closure
COPY --from=font-extractor /out/fonts/iosevka-nerd-font-mono /usr/local/share/fonts/iosevka-nerd-font-mono
COPY --from=font-extractor /out/licenses/iosevka-nerd-fonts /usr/share/licenses/iosevka-nerd-fonts
COPY container/verify-runtime.sh /usr/local/bin/verify-theme-harness-runtime

RUN chmod 0755 \
      /usr/local/libexec/theme-harness/install-fedora-closure.sh \
      /usr/local/bin/verify-theme-harness-fedora-closure \
      /usr/local/bin/verify-theme-harness-runtime && \
    dnf -y install \
      fontconfig-0:2.18.3-1.hum1.x86_64 \
      git-0:2.55.0-2.hum1.x86_64 \
      glibc-gconv-extra-0:2.43-8.5.hum1.x86_64 \
      gzip-0:1.14-4.hum1.x86_64 \
      tar-2:1.35-10.hum1.x86_64 \
      xz-1:5.8.3-2.hum1.x86_64 && \
    dnf clean all

# The locked Fedora transaction can replace Hummingbird packages. Restore every
# required Hummingbird direct package before verifying the final Fedora subset.
RUN /usr/local/libexec/theme-harness/install-fedora-closure.sh && \
    dnf -y install --allowerasing \
      fontconfig-0:2.18.3-1.hum1.x86_64 \
      git-0:2.55.0-2.hum1.x86_64 \
      glibc-gconv-extra-0:2.43-8.5.hum1.x86_64 \
      gzip-0:1.14-4.hum1.x86_64 \
      tar-2:1.35-10.hum1.x86_64 \
      xz-1:5.8.3-2.hum1.x86_64 && \
    dnf clean all && \
    rm -f /usr/local/libexec/theme-harness/install-fedora-closure.sh && \
    verify-theme-harness-fedora-closure && \
    fc-cache --force && \
    ln -s /usr/lib64/chromium-browser/headless_shell /usr/local/bin/chromium-browser && \
    ln -s /usr/local/bin/chromium-browser /usr/local/bin/chromium && \
    groupadd --gid 1001 nonroot && \
    useradd --uid 1001 --gid 1001 --create-home \
      --home-dir /home/nonroot --shell /bin/bash nonroot && \
    install -d -m 0755 -o nonroot -g nonroot \
      /home/nonroot/.config /home/nonroot/.local/share

USER nonroot
WORKDIR /workspaces
CMD ["/bin/bash"]
